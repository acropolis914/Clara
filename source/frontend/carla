# ----------------------------------------------------------------------------------------------------------------------
# Imports (Custom Stuff)

import os
import sys

from carla_app import (
    CarlaApplication,
)

from carla_host import (
    HostWindow,
    initHost,
    loadHostSettings,
)

from carla_shared import (
    CLARA_VERSION_STRING,
    getInitialProjectFile,
    gCarla,
    handleInitialCommandLineArguments,
    setUpSignals,
)

from qt_compat import QTimer

# ----------------------------------------------------------------------------------------------------------------------
# Early diagnostics (stderr is captured by the logger by the time we need these)

def _early_error(message):
    try:
        from carla_logger import logger
        fd = getattr(logger, "_orig_stderr_fd", None)
        if fd is not None:
            os.write(fd, (message + "\n").encode("utf-8", "replace"))
            return
    except Exception:
        pass
    print(message, file=sys.__stderr__)


# ----------------------------------------------------------------------------------------------------------------------
# Main

if __name__ == '__main__':
    import resources_rc

    # ------------------------------------------------------------------------------------------------------------------
    # Help for the Clara control client, before the host argument parser eats --help

    from clara_instance_core import first_positional

    _client_argv = [
        arg for arg in sys.argv[1:]
        if not arg.startswith("--with-appname=") and not arg.startswith("--with-libprefix=")
    ]
    _client_name = os.path.basename(sys.argv[0] or "")
    for _arg in sys.argv:
        if _arg.startswith("--with-appname="):
            _client_name = os.path.basename(_arg.split("=", 1)[1])
    _first = first_positional(_client_argv)
    if _client_name == "claramsg" or _first == "msg":
        _wants_help = any(arg in ("-h", "--help", "help", "--examples") for arg in _client_argv)
        _has_command = any(not arg.startswith("-") and arg not in ("msg", "help") for arg in _client_argv)
        if _wants_help or (_client_name == "claramsg" and not _has_command):
            if _first == "msg":
                _msg_args = _client_argv[_client_argv.index("msg") + 1:]
            else:
                _msg_args = _client_argv
            from carla_instance import run_msg_cli
            sys.exit(run_msg_cli(_msg_args, "", prog="claramsg" if _client_name == "claramsg" else "clara msg"))

    # ------------------------------------------------------------------------------------------------------------------
    # Read CLI args
    from carla_logger import logger
    logger.parse_cli_args()
    logger.start_capturing_stderr()

    initName, libPrefix = handleInitialCommandLineArguments(__file__ if "__file__" in dir() else None)

    from clara_instance_core import first_positional, instance_paths, is_clara_invocation, legacy_socket_path
    from carla_instance import (
        InstanceLock,
        MsgServer,
        forward_to_primary,
        run_msg_cli,
        socket_is_live,
    )

    _paths = instance_paths()

    # ------------------------------------------------------------------------------------------------------------------
    # `claramsg ...` control client (same as `clara msg ...`)

    if os.path.basename(initName or "") == "claramsg":
        _args = [arg for arg in sys.argv[1:]
                 if not arg.startswith("--with-appname") and not arg.startswith("--with-libprefix")]
        sys.exit(run_msg_cli(_args, _paths["socket"], prog="claramsg"))

    # ------------------------------------------------------------------------------------------------------------------
    # `clara msg ...` control client (Clara only, not available in Carla)

    if first_positional(sys.argv[1:]) == "msg":
        if not is_clara_invocation(initName):
            _early_error("`msg` is a Clara feature and is not available in Carla. Use `clara msg ...`.")
            sys.exit(2)
        _index = sys.argv.index("msg") + 1
        sys.exit(run_msg_cli(sys.argv[_index:], _paths["socket"], prog="clara msg"))

    # ------------------------------------------------------------------------------------------------------------------
    # Single instance: the lock is the source of truth, the socket is the transport.
    # The lock does not need Qt, so check it before building any application object.
    # Headless / control processes do not take the GUI lock.

    _lock = None
    _server = None
    _project_arg = getInitialProjectFile()

    if not gCarla.nogui:
        _lock = InstanceLock(_paths["lock"])
        if not _lock.acquire():
            _ok, _message = forward_to_primary(_paths["socket"], _project_arg)
            if _ok:
                print("Clara is already running; sent the request to the existing instance.")
                sys.exit(0)
            _pid = _lock.owner_pid()
            _early_error("Clara is already running (pid %s) but is not responding: %s" % (_pid, _message))
            sys.exit(1)

    # ------------------------------------------------------------------------------------------------------------------
    # App initialization

    app = CarlaApplication("Carla2", libPrefix)

    # Migration: an older build without a lock may still own a socket path.
    if _lock is not None:
        _legacy = legacy_socket_path()
        if socket_is_live(_paths["socket"]) or (_legacy != _paths["socket"] and socket_is_live(_legacy)):
            _lock.release()
            print("Clara is already running (older instance); activating it.")
            sys.exit(0)

    # ------------------------------------------------------------------------------------------------------------------
    # Control channel: listen before the host/GUI start, so a second launch never races startup.

    _msg_state = {"gui": None, "pending_open": None, "show": False}

    def _msg_early_handler(request):
        cmd = request.get("cmd")
        if cmd == "status":
            return {"v": 1, "ok": True, "data": {
                "pid": os.getpid(), "version": CLARA_VERSION_STRING, "mode": "starting",
                "project": _project_arg or "", "plugins": 0, "uptime": 0,
            }}
        if cmd == "open":
            path = request.get("path")
            if not path or not os.path.isfile(path):
                return {"v": 1, "ok": False, "error": {"code": "not_found", "message": "project not found: %s" % path}}
            _msg_state["pending_open"] = os.path.abspath(path)
            QTimer.singleShot(0, _apply_pending_open)
            return {"v": 1, "ok": True}
        if cmd == "list":
            return {"v": 1, "ok": False, "error": {"code": "starting", "message": "Clara is still starting"}}
        return {"v": 1, "ok": False, "error": {"code": "unsupported", "message": "unknown command: %s" % cmd}}

    def _apply_pending_open():
        gui = _msg_state["gui"]
        if gui is None:
            QTimer.singleShot(250, _apply_pending_open)
            return
        path = _msg_state["pending_open"]
        if not path:
            return
        _msg_state["pending_open"] = None
        gui.queueControlOpen(path)

    def _show_or_queue():
        gui = _msg_state["gui"]
        if gui is None:
            _msg_state["show"] = True
            return
        if hasattr(gui, "_restoreFromSystemTray"):
            gui._restoreFromSystemTray()
        else:
            gui.showIfNeeded()

    if _lock is not None:
        _server = MsgServer(_paths["socket"], _msg_early_handler)
        if not _server.start(remove_stale=True):
            logger.warning("APP", "Could not listen on %s: %s" % (_paths["socket"], _server.server.errorString()))
        _server.showRequested.connect(_show_or_queue)
        logger.debug("APP", "instance key=%s lock=%s socket=%s pid=%i" % (
            _paths["key"], _paths["lock"], _paths["socket"], os.getpid()))

    # ------------------------------------------------------------------------------------------------------------------
    # Set-up custom signal handling

    setUpSignals()

    # ------------------------------------------------------------------------------------------------------------------
    # Init host backend

    host = initHost(initName, libPrefix, False, False, True)
    loadHostSettings(host)

    # ------------------------------------------------------------------------------------------------------------------
    # Create GUI

    gui = HostWindow(host, True)

    if _server is not None:
        _server.handler = gui.handleMsgRequest
        gui.fSingleInstance = _server
        _msg_state["gui"] = gui
        if _msg_state["show"]:
            _msg_state["show"] = False
            _show_or_queue()
        if _msg_state["pending_open"]:
            QTimer.singleShot(0, _apply_pending_open)

    # ------------------------------------------------------------------------------------------------------------------
    # Show GUI

    gui.showIfNeeded()

    # ------------------------------------------------------------------------------------------------------------------
    # App-Loop

    app.exit_exec()

    # ------------------------------------------------------------------------------------------------------------------
    # Cleanup

    try:
        if _server is not None:
            _server.close()
    finally:
        if _lock is not None:
            _lock.release()
