/* ====================================================================================================
   Clara Base UI Primitives & Semantic Variable Foundation
   Variables follow the standard CSS syntax var(--name), substituted by the ThemeEngine.
   ==================================================================================================== */

/* Global Baseline */
QWidget {
    background-color: palette(window);
    color: palette(window-text);
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    selection-background-color: palette(highlight);
    selection-color: palette(window);
}

/* Window & Dialog Surfaces */
QMainWindow, QDialog {
    background-color: palette(window);
}

/* Tooltips: themed, rounded, compact */
QToolTip {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* Keyboard focus: swap the border color instead of growing the widget */
QPushButton:focus {
    border-color: palette(highlight);
}

QToolButton:focus, QListWidget:focus, QComboBox:focus {
    outline: 1px solid palette(highlight);
    outline-offset: -1px;
}

/* ToolBar & Menus */
QMenuBar {
    background-color: palette(base);
    color: palette(window-text);
    border-bottom: 1px solid palette(mid);
}

QMenuBar::item {
    background: transparent;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
}

QMenuBar::item:selected {
    background-color: palette(alternate-base);
    color: palette(highlight);
}

/* Main window toolbar: compact Win11-style command bar — normal-weight
   12px text beside 16px icons, flat buttons with soft rounded hovers */
QToolBar#toolBar {
    background-color: palette(base);
    border: none;
    padding: 3px var(--space-sm);
    spacing: 2px;
}

QToolBar#toolBar::separator {
    background-color: palette(mid);
    width: 1px;
    height: 16px;
    margin: 6px 5px;
}

QToolBar#toolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: normal;
    color: palette(window-text);
}

QToolBar#toolBar QToolButton:hover {
    background-color: palette(alternate-base);
    color: palette(window-text);
}

QToolBar#toolBar QToolButton:pressed {
    background-color: palette(mid);
    color: palette(window-text);
}

QToolBar#toolBar QToolButton:checked {
    background-color: palette(highlight);
    color: palette(window);
}

QMenu {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
    padding: var(--space-xs);
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: var(--radius-sm);
}

QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(window);
}

QMenu::separator {
    height: 1px;
    background-color: palette(mid);
    margin: var(--space-xs) 0px;
}

/* Headers & Typography Primitives */
QLabel#header, QLabel[role="header"] {
    font-size: var(--font-size-xl);
    font-weight: bold;
    color: palette(window-text);
}

QLabel#title, QLabel[role="title"] {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: palette(window-text);
}

QLabel#subtitle, QLabel[role="subtitle"] {
    font-size: var(--font-size-md);
    color: palette(placeholder-text);
}

QLabel#muted, QLabel[role="help"], QLabel[role="muted"] {
    font-size: var(--font-size-sm);
    color: palette(placeholder-text);
}

/* Push Button Primitives */
QPushButton {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-md);
    min-height: 22px;
}

/* LED tiles paint themselves entirely; button chrome would inflate them
   (min-height 22px made a 14px LED render 32px tall and clip in its grid). */
QPushButton[ledTile="true"] {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
    min-width: 0px;
}

QPushButton:hover {
    background-color: palette(alternate-base);
    border-color: palette(highlight);
}

QPushButton:pressed {
    background-color: palette(highlight);
    color: palette(window);
}

QPushButton:disabled {
    background-color: palette(base);
    color: palette(placeholder-text);
    border-color: palette(mid);
    opacity: 0.6;
}

/* Primary Accent Button (.btn-primary) */
QPushButton[primary="true"], QPushButton#btn_primary {
    background-color: palette(highlight);
    color: palette(window);
    font-weight: bold;
    border: 1px solid palette(highlight);
    border-radius: var(--radius-sm);
}

QPushButton[primary="true"]:hover, QPushButton#btn_primary:hover {
    background-color: palette(link);
    border-color: palette(link);
}

/* Subtle / Flat Button (.btn-subtle) */
QPushButton[flat="true"], QPushButton#btn_subtle {
    background: transparent;
    border: 1px solid transparent;
}

QPushButton[flat="true"]:hover, QPushButton#btn_subtle:hover {
    background-color: palette(alternate-base);
    border: 1px solid palette(mid);
}

/* Danger Button (.btn-danger) */
QPushButton[danger="true"], QPushButton#btn_danger {
    background-color: palette(link-visited);
    color: palette(highlighted-text);
    font-weight: bold;
    border: 1px solid palette(link-visited);
}

QPushButton[danger="true"]:hover, QPushButton#btn_danger:hover {
    background-color: palette(light);
    border-color: palette(light);
}

/* Filter Pills & Badges (.pill, .badge) */
QPushButton[pill="true"], QPushButton.pill {
    background-color: palette(base);
    color: palette(placeholder-text);
    border: 1px solid palette(mid);
    border-radius: var(--radius-full);
    padding: 2px 9px;
    font-size: var(--font-size-sm);
    font-weight: 500;
    min-height: 20px;
    max-height: 20px;
}

QPushButton[pill="true"]:hover, QPushButton.pill:hover {
    background-color: palette(alternate-base);
    border-color: palette(highlight);
    color: palette(window-text);
}

QPushButton[pill="true"]:checked, QPushButton.pill:checked {
    background-color: palette(highlight);
    color: palette(window);
    border-color: palette(highlight);
    font-weight: 600;
}

/* Canvas Floating Tool Palette (patchbay overlay toolbars) */
QFrame#canvas_toolbar_overlay, QFrame#canvas_context_toolbar_overlay {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
}

QFrame#canvas_toolbar_overlay QPushButton, QFrame#canvas_context_toolbar_overlay QPushButton {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: var(--radius-sm);
    color: palette(window-text);
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
}

/* Square tiles: equal min/max width and height, so the QSS box model can
   never squash the buttons into rectangles (it overrides setFixedSize). */
QFrame#canvas_toolbar_overlay QPushButton {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QFrame#canvas_context_toolbar_overlay QPushButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

/* The search field must fit the 32px bar: the global QLineEdit rule
   (min-height 22px + padding) polished it to ~30px tall and it clipped.
   18px content + 2px padding + 1px border = 24px widget. */
QFrame#canvas_context_toolbar_overlay QLineEdit {
    min-height: 0px;
    max-height: 18px;
    padding: 2px 8px;
}

/* Context toolbar section labels: small muted caps, vertically
   centered next to the 24px icon tiles instead of a large bold font. */
QLabel#canvasContextLabel {
    background: transparent;
    color: palette(midlight);
    font-size: 10px;
    font-weight: 700;
}

/* Canvas node search results (floating under the context toolbar field) */
QListWidget#canvasNodeSearchList {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: var(--radius-sm);
    padding: 2px;
    outline: none;
}

QListWidget#canvasNodeSearchList::item {
    padding: 3px 8px;
    border-radius: 4px;
}

QListWidget#canvasNodeSearchList::item:selected {
    background-color: palette(highlight);
    color: palette(window);
}

QFrame#canvas_toolbar_overlay QPushButton:hover, QFrame#canvas_context_toolbar_overlay QPushButton:hover {
    background-color: palette(alternate-base);
    color: palette(window-text);
    border: 1px solid palette(mid);
}

QFrame#canvas_toolbar_overlay QPushButton:checked, QFrame#canvas_context_toolbar_overlay QPushButton:checked {
    background-color: palette(highlight);
    color: palette(window);
    border: 1px solid palette(highlight);
}

QFrame#canvas_toolbar_overlay QPushButton:checked:hover, QFrame#canvas_context_toolbar_overlay QPushButton:checked:hover {
    background-color: palette(highlight);
    color: palette(window);
    border: 1px solid palette(highlight);
}

/* Form Inputs & Fields */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: palette(base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    min-height: 22px;
    selection-background-color: palette(highlight);
    selection-color: palette(window);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 1.5px solid palette(highlight);
    background-color: palette(window);
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: palette(window);
    color: palette(placeholder-text);
}

/* Cards & Module Containers */
QFrame#infoCard, QFrame[role="card"] {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
}

/* GroupBox Container Primitive */
QGroupBox {
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
    margin-top: 14px;
    padding-top: 14px;
    padding-bottom: 8px;
    padding-left: 6px;
    padding-right: 6px;
    font-weight: bold;
    color: palette(highlight);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: palette(highlight);
}

/* Rack Unit Capsule Primitive */
QFrame#rackPluginItem {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
}

QFrame#rackPluginItem:hover {
    background-color: palette(alternate-base);
    border-color: palette(midlight);
}

QFrame#rackPluginItem[selected="true"] {
    background-color: palette(shadow);
    border: 1.5px solid palette(highlight);
}

QLabel#rackPluginName {
    background: transparent;
    color: palette(window-text);
    font-size: var(--font-size-md);
    font-weight: 600;
}

/* Rack Slot child controls transparency (prevents rectangular opaque text blocks over color tints) */
QFrame#PluginWidget QLabel,
QFrame#PluginWidget QWidget#w_title_stack,
QFrame#PluginWidget QWidget#w_title_row,
QFrame#PluginWidget QWidget#w_slot_subrow,
QFrame#PluginWidget QWidget#w_buttons,
QFrame#rackPluginItem QLabel {
    background: transparent;
}

/* Modular Card Primitive */
QFrame#cardPluginItem QLabel {
    background: transparent;
}

QFrame#cardPluginItem {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: var(--radius-lg);
}

QFrame#cardPluginItem:hover {
    background-color: palette(alternate-base);
    border-color: palette(midlight);
}

QFrame#cardPluginItem[selected="true"] {
    background-color: palette(shadow);
    border: 2px solid palette(highlight);
}

QLabel#cardPluginName {
    color: palette(window-text);
    font-size: var(--font-size-md);
    font-weight: 600;
}

/* Badges & Tags */
QLabel#infoBadge, QLabel.badge {
    background-color: palette(alternate-base);
    border: 1px solid palette(mid);
    color: palette(highlight);
    font-weight: bold;
    font-size: var(--font-size-xs);
    border-radius: var(--radius-xs);
    padding: 1px 6px;
}

QLabel#infoMaker {
    color: palette(highlight);
    font-weight: 600;
}

QLabel#infoCategory {
    color: palette(placeholder-text);
    font-size: var(--font-size-sm);
}

QLabel#infoTag, QLabel.tag {
    background-color: palette(dark);
    border: 1px solid palette(dark);
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    font-size: var(--font-size-sm);
}

/* Table & Grid Views */
QTableWidget, QTableView, QTreeView, QListView {
    background-color: palette(window);
    alternate-background-color: palette(base);
    gridline-color: transparent;
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
    selection-background-color: palette(shadow);
    selection-color: palette(window-text);
    outline: none;
}

QTableWidget::item, QTableView::item {
    border-bottom: 1px solid palette(alternate-base);
    padding: var(--space-xs) var(--space-sm);
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: palette(shadow);
    color: palette(window-text);
}

/* Modern Sticky Table Header */
QHeaderView {
    background-color: palette(base);
    border: none;
    border-bottom: 1px solid palette(mid);
}

QHeaderView::section {
    background-color: palette(base);
    color: palette(window-text);
    font-weight: 600;
    font-size: var(--font-size-sm);
    padding: 5px var(--space-sm);
    border: none;
    border-right: 1px solid palette(alternate-base);
    border-bottom: 1px solid palette(mid);
}

QHeaderView::section:hover {
    background-color: palette(alternate-base);
    color: palette(highlight);
}

QHeaderView::section:checked {
    color: palette(highlight);
}

QTableCornerButton::section {
    background-color: palette(base);
    border: none;
    border-bottom: 1px solid palette(mid);
    border-right: 1px solid palette(alternate-base);
}

/* Transparent List Widget Items (removes OS selection fringe on custom item widgets) */
QListWidget#rackListWidget,
QListWidget#pluginRackListWidget, QListWidget#pluginCardsListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#rackListWidget::item,
QListWidget#pluginRackListWidget::item, QListWidget#pluginCardsListWidget::item {
    background: transparent;
    border: none;
    padding: 1px 0px;
}

QListWidget#rackListWidget::item:selected,
QListWidget#pluginRackListWidget::item:selected, QListWidget#pluginCardsListWidget::item:selected {
    background: transparent;
    border: none;
}

/* Tab Widgets & Panes */
QTabWidget::pane {
    border: 1px solid palette(mid);
    border-radius: var(--radius-md);
    background-color: palette(base);
}

QTabBar::tab {
    background-color: palette(base);
    color: palette(placeholder-text);
    border: 1px solid palette(mid);
    padding: 6px 14px;
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: palette(alternate-base);
    color: palette(window-text);
    border-bottom: 2px solid palette(highlight);
}

QTabBar::tab:hover:!selected {
    background-color: palette(alternate-base);
    color: palette(window-text);
}

/* Minimal Scrollbars */
/* Splitters (no hardcoded Fusion line; only show the handle on hover) */
QSplitter::handle {
    background-color: transparent;
    border: none;
}
QSplitter::handle:hover {
    background-color: palette(highlight);
}

QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border-radius: var(--radius-sm);
}

QScrollBar::handle:vertical {
    background-color: palette(mid);
    min-height: 24px;
    border-radius: var(--radius-sm);
}

QScrollBar::handle:vertical:hover {
    background-color: palette(highlight);
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border-radius: var(--radius-sm);
}

QScrollBar::handle:horizontal {
    background-color: palette(mid);
    min-width: 24px;
    border-radius: var(--radius-sm);
}

QScrollBar::handle:horizontal:hover {
    background-color: palette(highlight);
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}
